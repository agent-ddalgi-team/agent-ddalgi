# 각자 복사해서 .env 파일로 저장한 뒤 값을 채우세요
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 회사소개서 백엔드(backend/main.py) 추가 항목 ---
# 실행 모드: mock = 고정 Mock 결과(is_mock=true), llm = A의 extract_company_info 실제 호출.
# 지정하지 않으면 mock. mock/llm 외의 값이면 서버가 시작을 거부한다(조용히 mock으로 대체하지 않음).
AGENT_MODE=mock

# llm 모드에서 쓸 모델 이름. 키(OPENAI_API_KEY)는 위 항목을 그대로 쓴다.
OPENAI_MODEL=

# B 화면 폴더(index.html 위치). 지정하지 않으면 저장소의 frontend/를 본다.
# FRONTEND_DIR=
